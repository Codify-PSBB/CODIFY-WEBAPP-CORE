{
  "name": "coding-club-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:worker": "npm --prefix worker run dev",
    "build": "npm run build --workspaces --if-present && node scripts/sync-frontend-dist.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify-admin-security": "node scripts/verify-admin-security.js",
    "verify-production-integrity": "python3 scripts/verify-production-integrity.py",
    "verify-production-assets": "node scripts/verify-production-assets.mjs",
    "security-check": "npm run verify-admin-security && npm run verify-production-integrity && npm run verify-production-assets",
    "production-gate": "npm run typecheck && npm run build && npm run security-check"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "dompurify": "^3.3.4",
    "vite": "^6.4.2"
  }
}
